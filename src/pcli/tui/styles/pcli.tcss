Screen {
    background: $surface;
}

#status-pane {
    height: 3;
    background: $panel;
    color: $text;
    padding: 0 1;
    border-bottom: solid $primary-background;
    display: none;
}

#message-view {
    height: 1fr;
    padding: 1 2;
}

.message {
    margin-bottom: 1;
    padding: 0 1;
}

.message-user {
    border-left: thick $primary;
}

.message-assistant {
    border-left: thick $success;
}

.message-system {
    color: $text-muted;
}

.message-tool {
    border-left: thick $warning;
    color: $text-muted;
}

.message-shell {
    border-left: thick $accent;
    color: $text-muted;
}

.message-decision {
    border-left: thick $secondary;
}

.tool-result-collapsible {
    margin-bottom: 1;
    border-left: thick $warning;
    background: transparent;
}

.tool-result-collapsible.error {
    border-left: thick $error;
}

.tool-result-collapsible CollapsibleTitle {
    color: $text-muted;
}

#status-bar {
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

#input-box {
    height: 3;
    border: round $primary;
    margin: 0 1 1 1;
}

PermissionPromptModal, ImportPathModal, ModelListScreen {
    align: center middle;
}

#permission-modal, #import-modal, #model-list-modal {
    width: 70%;
    height: auto;
    max-height: 80%;
    background: $panel;
    border: thick $primary;
    padding: 1 2;
}

#import-modal Button {
    margin-top: 1;
    width: 100%;
}

#permission-buttons {
    height: auto;
    grid-size: 2;
    grid-gutter: 1;
    margin-top: 1;
}

#permission-buttons Button {
    width: 100%;
}

#model-list-modal ListView {
    height: auto;
    max-height: 20;
}

#sessions-title {
    padding: 1 1 0 1;
}
