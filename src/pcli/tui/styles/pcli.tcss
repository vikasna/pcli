Screen {
    background: $surface;
}

#status-pane {
    height: 5;
    background: $panel;
    color: $text;
    padding: 0 1;
    border-bottom: solid $primary-background;
    display: none;
}

#message-view {
    height: 1fr;
    padding: 1 2;
}

.message {
    margin-bottom: 1;
    padding: 0 1;
}

.message-user {
    border-left: thick $primary;
}

.message-assistant {
    border-left: thick $success;
}

.message-system {
    color: $text-muted;
}

.message-tool {
    border-left: thick $warning;
    color: $text-muted;
}

.message-shell {
    border-left: thick $accent;
    color: $text-muted;
}

.message-decision {
    border-left: thick $secondary;
}

.tool-result-collapsible {
    margin-bottom: 1;
    border-left: thick $warning;
    background: transparent;
}

.tool-result-collapsible.error {
    border-left: thick $error;
}

.tool-result-collapsible CollapsibleTitle {
    color: $text-muted;
}

.tool-call-collapsible {
    margin-bottom: 1;
    border-left: thick $warning;
    background: transparent;
}

.tool-call-collapsible CollapsibleTitle {
    color: $text-muted;
}

.reasoning-collapsible {
    margin-bottom: 1;
    /* $text-muted is an "auto"-computed contrast color (see Textual's
       design-variable table), which the border-color parser rejects as
       not a concrete color - unlike $foreground-muted, a real hex/rgba
       value with the same muted look, which resolves fine here. */
    border-left: thick $foreground-muted;
    background: transparent;
}

.reasoning-collapsible CollapsibleTitle {
    color: $text-muted;
}

.message-collapsible {
    margin-bottom: 1;
    background: transparent;
}

.message-collapsible CollapsibleTitle {
    color: $text-muted;
}

.message-collapsible-system {
    border-left: thick $foreground-muted;
}

.message-collapsible-shell {
    border-left: thick $accent;
}

#status-bar {
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

#input-box {
    height: 3;
    border: round $primary;
    margin: 0 1 1 1;
}

/* Hidden by default (ChatInput.SuggestionsChanged toggles it - see
   CommandSuggestions.update_suggestions) - sits directly above the input
   box it's completing for. */
#command-suggestions {
    display: none;
    height: auto;
    max-height: 8;
    border: round $primary;
    margin: 0 1;
    background: $panel;
}

/* Pinned to the top (not centered) so the chat transcript stays visible
   underneath through ModalScreen's translucent background - a question or
   permission prompt is much easier to act on with its own surrounding
   context still in view than centered over the middle of it. */
PermissionPromptModal, ImportPathModal, ModelListScreen, AskQuestionModal, ConfirmModal {
    align: center top;
}

#permission-modal, #import-modal, #model-list-modal, #ask-question-modal, #confirm-modal {
    width: 70%;
    height: auto;
    max-height: 80%;
    margin-top: 1;
    background: $panel;
    border: thick $primary;
    padding: 1 2;
}

#confirm-modal Button {
    width: 100%;
    height: 1;
    border: none;
    margin-top: 1;
}

/* Full-screen, unlike the other (centered, floating-box) modals above -
   this is a dedicated view for watching a subagent work, not a quick
   prompt, so it takes over the whole window the same way the main chat
   screen does. */
#subagent-activity-modal {
    width: 100%;
    height: 100%;
    background: $panel;
    padding: 1 2;
}

#subagent-activity-title {
    height: auto;
    text-style: bold;
    padding-bottom: 1;
    border-bottom: solid $primary;
}

#subagent-activity-scroll {
    height: 1fr;
}

#subagent-activity-close-button {
    width: 100%;
    margin-top: 1;
}

#ask-question-options {
    height: auto;
    margin-top: 1;
}

/* Flat, single-line buttons (no border) so a multi-option question stays
   compact now that the modal is pinned to the top of the screen - see the
   alignment comment above. */
#ask-question-options Button {
    width: 100%;
    height: 1;
    border: none;
    margin-bottom: 1;
}

#ask-question-input {
    margin-top: 1;
}

#import-modal Button {
    margin-top: 1;
    width: 100%;
    height: 1;
    border: none;
}

#permission-buttons {
    height: auto;
    grid-size: 2;
    grid-gutter: 1;
    margin-top: 1;
}

#permission-buttons Button {
    width: 100%;
    height: 1;
    border: none;
}

#model-list-modal ListView {
    height: auto;
    max-height: 20;
}

#sessions-title {
    padding: 1 1 0 1;
}

#sessions-header {
    padding: 0 1 0 1;
    text-style: bold;
}
