# Local model weights and anything dropped alongside them (chat templates,
# readmes, ...) - this is scratch space for locally-tested models, not part
# of the project; large binaries also never belong in git (GitHub hard-rejects
# anything over 100MB anyway).
models/
*.gguf

pcli-session.json
pcli-session.txt

